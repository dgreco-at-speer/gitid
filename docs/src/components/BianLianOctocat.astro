---
// Animated hero mascot for the docs landing page: an original octopus-cat
// (NOT GitHub's trademarked Octocat) performing bian lian — Sichuan opera
// face-changing. It cycles through five painted opera masks, each swap hidden
// behind a fan swipe — a visual metaphor for gitid swapping git identities per
// directory. The bare face is never shown; a mask is always worn.
//
// Pure CSS animation, no JS. Authored as inline SVG (not an <img>) so it can
// read Starlight's theme via CSS custom properties and honour
// prefers-reduced-motion. All ids/classes are prefixed `blx-`.
//
// Choreography: a 14s master loop = 5 phases x 2.8s. Each mask has its own
// 14s keyframe window; the fan swipe + head flick run on a 2.8s loop that
// stays phase-locked (14 = 5 x 2.8), covering the face at every swap instant.
---

<svg
  class="blx-svg"
  viewBox="0 0 400 400"
  role="img"
  aria-label="An octopus-cat mascot performing Sichuan opera face-changing, swapping between painted opera masks — like gitid swapping git identities."
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <!-- Shared mask silhouette: every mask reuses this so a swap reads as a
         face change, not a shape change. -->
    <path
      id="blx-face-plate"
      d="M 200 108 C 250 108 292 138 292 178 C 292 215 268 245 232 256 C 220 260 210 262 200 262 C 190 262 180 260 168 256 C 132 245 108 215 108 178 C 108 138 150 108 200 108 Z"
    ></path>
    <clipPath id="blx-face-clip">
      <use href="#blx-face-plate"></use>
    </clipPath>
    <!-- Shared wide, round eyes — used by every mask so the gaze stays
         consistent and friendly through each change. -->
    <g id="blx-eyes">
      <ellipse cx="162" cy="179" rx="22" ry="17" fill="#f7f2e8"></ellipse>
      <ellipse cx="238" cy="179" rx="22" ry="17" fill="#f7f2e8"></ellipse>
      <circle cx="162" cy="180" r="10.5" fill="#2a2233"></circle>
      <circle cx="238" cy="180" r="10.5" fill="#2a2233"></circle>
      <circle cx="158" cy="176" r="3.4" fill="#ffffff" opacity="0.92"></circle>
      <circle cx="234" cy="176" r="3.4" fill="#ffffff" opacity="0.92"></circle>
    </g>
  </defs>

  <!-- Soft themed backdrop (follows the Starlight theme toggle). -->
  <circle cx="200" cy="196" r="172" fill="var(--sl-color-accent-low)" opacity="0.55"></circle>

  <g class="blx-bob">
    <!-- Tentacles behind the head (idle sway). -->
    <g fill="none" stroke="#7a5aa6" stroke-width="28" stroke-linecap="round">
      <path class="blx-t blx-t1" d="M 150 250 C 120 285 108 325 120 350"></path>
      <path class="blx-t blx-t2" d="M 175 258 C 165 300 150 335 158 360"></path>
      <path class="blx-t blx-t3" d="M 200 260 C 200 305 200 340 200 366"></path>
      <path class="blx-t blx-t4" d="M 225 258 C 235 300 250 335 242 360"></path>
      <path class="blx-t blx-t5" d="M 250 250 C 280 285 292 325 280 350"></path>
    </g>

    <!-- Raised arm tentacle that holds the fan (static). -->
    <path
      class="blx-arm"
      d="M 250 256 C 285 250 315 248 336 244"
      fill="none"
      stroke="#7a5aa6"
      stroke-width="22"
      stroke-linecap="round"
    ></path>

    <!-- Head (flicks at each mask change). -->
    <g class="blx-head">
      <!-- Ears — short and round (behind the head blob). -->
      <ellipse cx="132" cy="94" rx="30" ry="28" fill="#7a5aa6"></ellipse>
      <ellipse cx="132" cy="98" rx="17" ry="16" fill="#f0a6c0"></ellipse>
      <ellipse cx="268" cy="94" rx="30" ry="28" fill="#7a5aa6"></ellipse>
      <ellipse cx="268" cy="98" rx="17" ry="16" fill="#f0a6c0"></ellipse>

      <path
        d="M 200 92 C 268 92 314 130 314 182 C 314 236 268 276 200 276 C 132 276 86 236 86 182 C 86 130 132 92 200 92 Z"
        fill="#7a5aa6"
      ></path>

      <!-- Masks (one visible at a time). -->
      <g class="blx-masks">
        <!-- Mask 1 — COBALT BLUE: gold flame brows. -->
        <g class="blx-mask blx-mask-1">
          <use href="#blx-face-plate" fill="#1e5fae" stroke="#e0a92e" stroke-width="3"></use>
          <g clip-path="url(#blx-face-clip)">
            <path d="M 130 165 C 140 140 160 138 176 150 C 168 146 164 136 168 126 C 160 132 150 130 148 140 C 146 128 136 126 130 134 C 138 142 132 156 130 165 Z" fill="#e8b53a"></path>
            <path d="M 270 165 C 260 140 240 138 224 150 C 232 146 236 136 232 126 C 240 132 250 130 252 140 C 254 128 264 126 270 134 C 262 142 268 156 270 165 Z" fill="#e8b53a"></path>
            <path d="M 200 116 C 210 128 210 144 200 150 C 190 144 190 128 200 116 Z" fill="#e8b53a"></path>
            <path d="M 186 236 Q 200 250 214 236 Q 200 244 186 236 Z" fill="#e8b53a"></path>
            <circle cx="138" cy="206" r="5" fill="#f7f2e8"></circle>
            <circle cx="262" cy="206" r="5" fill="#f7f2e8"></circle>
            <path d="M 178 212 Q 200 228 222 212" stroke="#e8b53a" stroke-width="5" fill="none" stroke-linecap="round"></path>
          </g>
          <use href="#blx-eyes"></use>
        </g>

        <!-- Mask 2 — JADE GREEN: white cloud swirls. -->
        <g class="blx-mask blx-mask-2">
          <use href="#blx-face-plate" fill="#1f8a4c" stroke="#e0a92e" stroke-width="3"></use>
          <g clip-path="url(#blx-face-clip)">
            <circle cx="200" cy="132" r="7" fill="#e8b53a"></circle>
            <path d="M 134 164 Q 160 150 184 166" stroke="#f2fbf5" stroke-width="5" fill="none" stroke-linecap="round"></path>
            <path d="M 266 164 Q 240 150 216 166" stroke="#f2fbf5" stroke-width="5" fill="none" stroke-linecap="round"></path>
            <path d="M 132 206 c -6 -12 10 -20 18 -10 c 6 8 -4 16 -10 10 c -3 -3 2 -7 5 -4" fill="none" stroke="#f2fbf5" stroke-width="4" stroke-linecap="round"></path>
            <path d="M 268 206 c 6 -12 -10 -20 -18 -10 c -6 8 4 16 10 10 c 3 -3 -2 -7 -5 -4" fill="none" stroke="#f2fbf5" stroke-width="4" stroke-linecap="round"></path>
            <path d="M 178 213 Q 200 228 222 213" stroke="#f2fbf5" stroke-width="4" fill="none" stroke-linecap="round"></path>
          </g>
          <use href="#blx-eyes"></use>
        </g>

        <!-- Mask 3 — MAGENTA: gold geometry. -->
        <g class="blx-mask blx-mask-3">
          <use href="#blx-face-plate" fill="#c0297a" stroke="#e0a92e" stroke-width="3"></use>
          <g clip-path="url(#blx-face-clip)">
            <path d="M 200 116 L 214 136 L 200 156 L 186 136 Z" fill="#e8b53a"></path>
            <path d="M 128 168 L 150 154 L 186 168 L 156 166 Z" fill="#e8b53a"></path>
            <path d="M 272 168 L 250 154 L 214 168 L 244 166 Z" fill="#e8b53a"></path>
            <path d="M 118 200 L 146 196 L 136 222 Z" fill="#f7f2e8"></path>
            <path d="M 282 200 L 254 196 L 264 222 Z" fill="#f7f2e8"></path>
            <rect x="180" y="236" width="40" height="7" rx="3" fill="#e8b53a"></rect>
            <path d="M 176 213 Q 200 229 224 213" stroke="#e8b53a" stroke-width="5" fill="none" stroke-linecap="round"></path>
          </g>
          <use href="#blx-eyes"></use>
        </g>

        <!-- Mask 4 — TEAL: gold flame cheeks. -->
        <g class="blx-mask blx-mask-4">
          <use href="#blx-face-plate" fill="#12808f" stroke="#e0a92e" stroke-width="3"></use>
          <g clip-path="url(#blx-face-clip)">
            <path d="M 200 118 C 208 128 208 142 200 148 C 192 142 192 128 200 118 Z" fill="#e8b53a"></path>
            <path d="M 200 156 L 200 198" stroke="#f2f7f8" stroke-width="3"></path>
            <path d="M 130 166 Q 156 150 182 164 Q 158 158 132 170 Z" fill="#f2f7f8"></path>
            <path d="M 270 166 Q 244 150 218 164 Q 242 158 268 170 Z" fill="#f2f7f8"></path>
            <path d="M 120 215 C 132 195 150 198 156 210 C 152 202 158 194 168 192 C 162 202 168 212 160 222 C 150 230 128 228 120 215 Z" fill="#e8b53a"></path>
            <path d="M 280 215 C 268 195 250 198 244 210 C 248 202 242 194 232 192 C 238 202 232 212 240 222 C 250 230 272 228 280 215 Z" fill="#e8b53a"></path>
            <path d="M 178 213 Q 200 230 222 213" stroke="#f2f7f8" stroke-width="4" fill="none" stroke-linecap="round"></path>
          </g>
          <use href="#blx-eyes"></use>
        </g>

        <!-- Mask 5 — VIOLET: white swirled brows, gold studs. -->
        <g class="blx-mask blx-mask-5">
          <use href="#blx-face-plate" fill="#6a2fb8" stroke="#e0a92e" stroke-width="3"></use>
          <g clip-path="url(#blx-face-clip)">
            <path d="M 124 170 C 132 146 160 146 182 160 C 168 150 148 152 138 162 C 150 154 168 156 178 168 Z" fill="#f4eefb"></path>
            <path d="M 276 170 C 268 146 240 146 218 160 C 232 150 252 152 262 162 C 250 154 232 156 222 168 Z" fill="#f4eefb"></path>
            <path d="M 200 114 C 214 132 210 150 200 156 C 190 150 186 132 200 114 Z" fill="#f4eefb"></path>
            <circle cx="150" cy="150" r="4" fill="#e8b53a"></circle>
            <circle cx="250" cy="150" r="4" fill="#e8b53a"></circle>
            <circle cx="200" cy="168" r="4" fill="#e8b53a"></circle>
            <path d="M 130 210 c -4 -14 16 -18 22 -4 c 3 8 -8 12 -13 6" fill="none" stroke="#f4eefb" stroke-width="4" stroke-linecap="round"></path>
            <path d="M 270 210 c 4 -14 -16 -18 -22 -4 c -3 8 8 12 13 6" fill="none" stroke="#f4eefb" stroke-width="4" stroke-linecap="round"></path>
            <path d="M 176 213 Q 200 230 224 213" stroke="#e8b53a" stroke-width="5" fill="none" stroke-linecap="round"></path>
          </g>
          <use href="#blx-eyes"></use>
        </g>
      </g>
    </g>

    <!-- Fan (swipes across the face at each swap, hiding the change). -->
    <g class="blx-fan">
      <line x1="338" y1="292" x2="352" y2="322" stroke="#7a5230" stroke-width="7" stroke-linecap="round"></line>
      <ellipse cx="338" cy="244" rx="46" ry="54" fill="#c8102e" stroke="#e0a92e" stroke-width="5"></ellipse>
      <ellipse cx="338" cy="244" rx="30" ry="37" fill="none" stroke="#e0a92e" stroke-width="2"></ellipse>
      <circle cx="338" cy="244" r="9" fill="#e0a92e"></circle>
      <g fill="#f5e6b0">
        <circle cx="338" cy="230" r="4"></circle>
        <circle cx="338" cy="258" r="4"></circle>
        <circle cx="325" cy="244" r="4"></circle>
        <circle cx="351" cy="244" r="4"></circle>
      </g>
    </g>
  </g>
</svg>

<style>
  .blx-svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  /* All transformed groups pivot in viewBox coordinates. */
  .blx-bob,
  .blx-head,
  .blx-fan,
  .blx-t {
    transform-box: view-box;
  }

  /* Idle: whole-body bob. */
  .blx-bob {
    animation: blx-bob 4.6s ease-in-out infinite alternate;
  }

  /* Head flick, phase-locked with the fan swipe (2.8s). */
  .blx-head {
    transform-origin: 200px 278px;
    animation: blx-flick 2.8s ease-in-out infinite;
  }

  /* Fan swipe: rests beside the body, whips across the face at each swap. */
  .blx-fan {
    transform-origin: 338px 244px;
    animation: blx-swipe 2.8s cubic-bezier(0.5, 0, 0.3, 1) infinite;
  }

  /* Masks: one visible at a time on the shared 14s loop. Base state (used when
     motion is reduced) shows mask 1. */
  .blx-mask {
    opacity: 0;
  }
  .blx-mask-1 {
    opacity: 1;
    animation: blx-m1 14s linear infinite;
  }
  .blx-mask-2 {
    animation: blx-m2 14s linear infinite;
  }
  .blx-mask-3 {
    animation: blx-m3 14s linear infinite;
  }
  .blx-mask-4 {
    animation: blx-m4 14s linear infinite;
  }
  .blx-mask-5 {
    animation: blx-m5 14s linear infinite;
  }

  /* Tentacle sway (free-running, deliberately unsynced). */
  .blx-t1 { transform-origin: 150px 250px; animation: blx-sway 3.1s ease-in-out infinite alternate; }
  .blx-t2 { transform-origin: 175px 258px; animation: blx-sway 3.7s ease-in-out infinite alternate; animation-delay: -1.2s; }
  .blx-t3 { transform-origin: 200px 260px; animation: blx-sway2 4.1s ease-in-out infinite alternate; }
  .blx-t4 { transform-origin: 225px 258px; animation: blx-sway 3.4s ease-in-out infinite alternate; animation-delay: -0.6s; }
  .blx-t5 { transform-origin: 250px 250px; animation: blx-sway2 3.9s ease-in-out infinite alternate; animation-delay: -1.5s; }

  @keyframes blx-m1 {
    0%, 19.99% { opacity: 1; }
    20%, 100% { opacity: 0; }
  }
  @keyframes blx-m2 {
    0%, 19.99% { opacity: 0; }
    20%, 39.99% { opacity: 1; }
    40%, 100% { opacity: 0; }
  }
  @keyframes blx-m3 {
    0%, 39.99% { opacity: 0; }
    40%, 59.99% { opacity: 1; }
    60%, 100% { opacity: 0; }
  }
  @keyframes blx-m4 {
    0%, 59.99% { opacity: 0; }
    60%, 79.99% { opacity: 1; }
    80%, 100% { opacity: 0; }
  }
  @keyframes blx-m5 {
    0%, 79.99% { opacity: 0; }
    80%, 99.99% { opacity: 1; }
    100% { opacity: 0; }
  }

  /* 2.8s loop: face fully covered at 0%/100% (the swap instant), at rest 16–84%. */
  @keyframes blx-swipe {
    0% { transform: translate(-138px, -69px) scale(2.05) rotate(-12deg); }
    8% { transform: translate(-60px, -24px) scale(1.5) rotate(18deg); }
    16%, 84% { transform: translate(0, 0) scale(1) rotate(5deg); }
    92% { transform: translate(-60px, -24px) scale(1.5) rotate(18deg); }
    100% { transform: translate(-138px, -69px) scale(2.05) rotate(-12deg); }
  }

  @keyframes blx-flick {
    0% { transform: rotate(-6deg); }
    8% { transform: rotate(3deg); }
    16%, 84% { transform: rotate(0deg); }
    92% { transform: rotate(3deg); }
    100% { transform: rotate(-6deg); }
  }

  @keyframes blx-bob {
    from { transform: translateY(0); }
    to { transform: translateY(-6px); }
  }

  @keyframes blx-sway {
    from { transform: rotate(-3deg); }
    to { transform: rotate(4deg); }
  }
  @keyframes blx-sway2 {
    from { transform: rotate(3deg); }
    to { transform: rotate(-4deg); }
  }

  /* Reduced motion: freeze on the octocat wearing mask 1. */
  @media (prefers-reduced-motion: reduce) {
    .blx-bob,
    .blx-head,
    .blx-fan,
    .blx-mask-1,
    .blx-mask-2,
    .blx-mask-3,
    .blx-mask-4,
    .blx-mask-5,
    .blx-t1,
    .blx-t2,
    .blx-t3,
    .blx-t4,
    .blx-t5 {
      animation: none;
    }
  }
</style>
